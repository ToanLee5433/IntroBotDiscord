# Discord Bot Configuration
PORT=8080
DISCORD_TOKEN=your_discord_bot_token_here

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Databases
MONGO_URI=your_mongodb_connection_uri_here

# Valorant API (Optional)
VALORANT_API_KEY=your_valorant_api_key_here

# Warmup Feature configuration
# ID of the secret Discord text channel where the bot will store the warmup video files
WARMUP_CHANNEL_ID=your_discord_storage_channel_id_here
